{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "augmentic-accounting-site",
  "compatibility_date": "2026-08-28",
  "routes": [
    {
      "pattern": "augmenticaccounting.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mcp"
    ]
  },
  "main": "worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  }
}
