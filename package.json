{
  "name": "augmentic-accounting-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static build and Cloudflare deployment tooling for Augmentic Accounting",
  "scripts": {
    "build": "uv run python scripts/build_static.py",
    "test": "uv run pytest",
    "dev": "npm run build && wrangler dev",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
